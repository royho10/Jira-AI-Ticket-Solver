# Copy this file to .env and fill in your actual values

# Required - Jira Configuration
ATLASSIAN_INSTANCE_URL=https://your-company.atlassian.net
ATLASSIAN_EMAIL=your-email@company.com
ATLASSIAN_API_TOKEN=your_api_token_here

# Azure OpenAI Configuration
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/
AZURE_OPENAI_API_KEY=your_azure_openai_api_key_here
AZURE_OPENAI_API_VERSION=2024-08-01-preview
AZURE_OPENAI_LLM_DEPLOYMENT=gpt-5-nano
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=text-embedding-3-small

# Weaviate Configuration (optional)
# Leave WEAVIATE_URL unset to use a local Docker instance on the default ports.
# Set it to point the app and the indexer at a shared remote Weaviate.
# WEAVIATE_URL=https://weaviate.your-company.internal
# WEAVIATE_API_KEY=your_weaviate_api_key_here
# WEAVIATE_GRPC_PORT=50051

# Remote MCP Server (optional)
# Comma-separated list of browser Origins allowed to call the server. Requests
# with no Origin header (Claude Code, curl) are unaffected; a stated Origin that
# is not listed is refused, which is what blocks DNS rebinding.
# MCP_ALLOWED_ORIGINS=https://claude.ai
# MCP_SSE_KEEPALIVE_SECONDS=15
# MCP_SSE_STREAM_SECONDS=300
